<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_oneui_base"
    android:backgroundTint="#BF171920">

    <ImageView
        android:id="@+id/dw_bg_plate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_plate_dark" />

    <ImageView
        android:id="@+id/dw_bg_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="16dp"
        android:paddingRight="18dp"
        android:paddingBottom="14dp">

        <!-- 顶部专辑封面 + 曲名歌手音质 + 收藏按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dw_cover"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_widget_cover_placeholder"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_alger_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="13dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dw_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="AlgerMusicPlayer"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dw_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="6dp"
                        android:background="@drawable/bg_widget_badge"
                        android:maxLines="1"
                        android:paddingLeft="5dp"
                        android:paddingTop="1.5dp"
                        android:paddingRight="5dp"
                        android:paddingBottom="1.5dp"
                        android:text="超清母带"
                        android:textColor="#FF34D399"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/dw_artist"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="全尺寸桌面歌词播控"
                        android:textColor="#B8FFFFFF"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/dw_btn_fav"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="收藏"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_heart_outline" />
        </LinearLayout>

        <!-- 中央多行实时滚动歌词舞台 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dw_lyric_prev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="上一句歌词自动淡出"
                android:textColor="#66FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dw_lyric_cur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2"
                android:shadowColor="#8C000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:text="♪ 播放音乐实时显示多行歌词"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/dw_lyric_cur_img"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dw_lyric_trans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="支持双语译文与缩放字号联动"
                android:textColor="#E634D399"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dw_lyric_next1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="下一句歌词实时预读"
                android:textColor="#8CFFFFFF"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/dw_lyric_next2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="支持自由拉大缩小整个组件"
                android:textColor="#4DFFFFFF"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- 底部全功能播控栏 + 字号快捷调节 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/dw_btn_mode"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="播放模式"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_mode_loop" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/dw_btn_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="上一首"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_prev" />

            <ImageButton
                android:id="@+id/dw_btn_play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:background="@drawable/bg_widget_play_circle"
                android:contentDescription="播放暂停"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play" />

            <ImageButton
                android:id="@+id/dw_btn_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="下一首"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_next" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/dw_btn_font"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="调节字号"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_font_size" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
